# Réglages de Meydan, lus par scripts/run.sh (copier en meydan.env ; seules les lignes MEYDAN_…=… comptent).
# Tout est facultatif : sans rien, Meydan écoute sur 127.0.0.1:3070, sans porte publique.

# Port local (Meydan n'écoute jamais que sur 127.0.0.1).
#MEYDAN_PORT=3070

# Porte publique derrière nginx (HTTPS) : le nom exact servi par nginx. Exige data/auth.json
# (node scripts/creer-acces.mjs <identifiant>). Vide = pas d'accès public, seulement le lien à clé local.
#MEYDAN_PUBLIC_HOST=meydan.example.com

# Dictée et notes vocales : ffmpeg et une transcription locale (transcribe-cpp + un modèle Parakeet en GGUF).
#MEYDAN_FFMPEG=/usr/bin/ffmpeg
#MEYDAN_ASR_CLI=/opt/transcribe-cpp/bin/transcribe-cli
#MEYDAN_ASR_MODEL=/opt/models/parakeet-tdt-0.6b-v3-Q8_0.gguf

# Chromium : navigateur sans écran des consoles (meydan nav, défaut /snap/bin/chromium) et impression PDF des ateliers.
#MEYDAN_NAV_BIN=/snap/bin/chromium
#MEYDAN_CHROME=/snap/bin/chromium

# Second compte Claude / Codex : dossiers de configuration à part (défaut ~/.meydan-comptes/claude-2 et codex-2).
#MEYDAN_COMPTE2_CLAUDE=/home/moi/.meydan-comptes/claude-2
#MEYDAN_COMPTE2_CODEX=/home/moi/.meydan-comptes/codex-2

# Serveur MCP de navigateur à donner aux équipiers Claude (chemin d'un script node), facultatif.
#MEYDAN_NAVIGATEUR_MCP=/opt/mon-pont-navigateur/src/mcp.mjs
